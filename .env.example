# Pharma Invent - Environment Configuration

# Database: PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pharma_invent

# Security & Session Secrets
JWT_SECRET=pharma_invent_super_secure_secret_key_2026_at_least_32_chars!
NEXT_PUBLIC_APP_NAME="Pharma Invent POS"
NEXT_PUBLIC_STORE_NAME="Al-Shifa Community Pharmacy"
NEXT_PUBLIC_STORE_ADDRESS="Suite 104, Medical Central Boulevard"
NEXT_PUBLIC_STORE_PHONE="+1 (555) 019-2834"

# AI Integration (OpenRouter or Ollama)
# For OpenRouter:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# For Local Ollama:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
AI_PROVIDER=openrouter # or 'ollama'

# Hardware Settings
DEFAULT_RECEIPT_PRINTER="Thermal-80mm"
PRINTER_PAPER_WIDTH="80mm" # or '58mm'
AUTO_PRINT_RECEIPT=true
BARCODE_SCANNER_DELAY_MS=30
